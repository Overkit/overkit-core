<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Types du State Bus générés depuis schema/state-bus.v1.schema.json.
         Publiés en paquet car le SDK les expose aux modules tiers. -->
    <PackageId>Overkit.Contracts</PackageId>
    <Version>0.3.0-alpha</Version>
    <Authors>Nallraen</Authors>
    <Description>State Bus contract types for Overkit modules, generated from the JSON Schema.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Overkit/overkit-core</PackageProjectUrl>
  </PropertyGroup>

</Project>
