<Window
    x:Class="Overkit.Host.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Overkit.Host"
    Title="Overkit">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Zone de titre (la barre système est étendue dans le contenu) -->
        <TextBlock Text="Overkit" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <TextBlock Text="Palbox" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Bottom" Opacity="0.6" Margin="0,0,0,4" />
        </StackPanel>

        <ListView
            x:Name="PalList"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PalRow">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind GenderGlyph}" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{x:Bind GenderBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind SubName}" Opacity="0.55" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind LevelText}" VerticalAlignment="Center" Opacity="0.9" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Talents}" VerticalAlignment="Center"
                                   FontFamily="Consolas" FontSize="13" Opacity="0.8" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Passives}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
