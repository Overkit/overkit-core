<UserControl
    x:Class="Overkit.Host.Views.CardEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Overkit.Host.Views">

    <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Colonne gauche : construction -->
        <ScrollViewer>
            <StackPanel Spacing="14">

                <TextBox x:Name="CardName" Header="Nom de ma card" PlaceholderText="Mes femelles de haut niveau" />

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Ajouter un bloc" FontWeight="SemiBold" />

                        <ComboBox x:Name="BlockType" Header="Je veux…" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="Compter quelque chose" Tag="counter" />
                            <ComboBoxItem Content="Afficher une liste" Tag="list" />
                            <ComboBoxItem Content="Être alerté" Tag="alert" />
                            <ComboBoxItem Content="Afficher une valeur du jeu" Tag="global" />
                        </ComboBox>

                        <ComboBox x:Name="SourceBox" Header="Parmi" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Label" SelectionChanged="Source_Changed" />

                        <ComboBox x:Name="GlobalBox" Header="Valeur" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Label" Visibility="Collapsed" />

                        <!-- Filtre optionnel -->
                        <StackPanel x:Name="FilterPanel" Spacing="6">
                            <TextBlock Text="Filtre (facultatif)" Opacity="0.6" FontSize="12" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="FilterField" HorizontalAlignment="Stretch" DisplayMemberPath="Label" />
                                <ComboBox x:Name="FilterOperator" Grid.Column="1" HorizontalAlignment="Stretch"
                                          DisplayMemberPath="Label" />
                                <TextBox x:Name="FilterValue" Grid.Column="2" PlaceholderText="40" />
                                <Button x:Name="AddFilter" Grid.Column="3" Content="+" Click="AddFilter_Click"
                                        ToolTipService.ToolTip="Ajouter ce filtre" />
                            </Grid>
                            <ItemsControl x:Name="FilterList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:FilterChip">
                                        <Grid ColumnSpacing="6" Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" FontSize="12" />
                                            <HyperlinkButton Grid.Column="1" Content="retirer" FontSize="11" Padding="4,0"
                                                             Click="RemoveFilter_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Spécifique liste -->
                        <StackPanel x:Name="ListOptions" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="Colonnes à afficher" Opacity="0.6" FontSize="12" />
                            <ItemsControl x:Name="ColumnChecks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ColumnChoice">
                                        <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind Selected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ComboBox x:Name="SortField" Header="Trier par" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Label" />
                            <ToggleSwitch x:Name="SortDesc" OnContent="Du plus grand au plus petit"
                                          OffContent="Du plus petit au plus grand" IsOn="True" />
                        </StackPanel>

                        <TextBox x:Name="BlockLabel" Header="Intitulé affiché"
                                 PlaceholderText="Femelles de niveau 40+" />

                        <ComboBox x:Name="AlertLevel" Header="Gravité de l'alerte" HorizontalAlignment="Stretch"
                                  SelectedIndex="1" Visibility="Collapsed">
                            <ComboBoxItem Content="Information" Tag="info" />
                            <ComboBoxItem Content="Avertissement" Tag="warning" />
                            <ComboBoxItem Content="Critique" Tag="critical" />
                        </ComboBox>

                        <Button Content="Ajouter ce bloc à ma card" Click="AddBlock_Click"
                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock Text="Blocs de ma card" FontWeight="SemiBold" />
                    <ItemsControl x:Name="BlockList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:BlockChip">
                                <Grid ColumnSpacing="8" Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <HyperlinkButton Grid.Column="1" Content="supprimer" FontSize="11" Padding="4,0"
                                                     Click="RemoveBlock_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoBlocks" Text="Aucun bloc pour l'instant — ajoute-en un ci-dessus."
                               Opacity="0.5" FontSize="12" />
                </StackPanel>

                <Button x:Name="SaveButton" Content="Enregistrer ma card" Click="Save_Click"
                        HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                <TextBlock x:Name="SaveStatus" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- Colonne droite : aperçu en direct -->
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Aperçu en direct" FontWeight="SemiBold" Opacity="0.7" />
            <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="14">
                <local:ModuleHostView x:Name="Preview" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
