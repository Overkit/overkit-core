<UserControl
    x:Class="Overkit.Host.Views.CraftView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Overkit.Host.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="RecipeBox" PlaceholderText="Choisir une recette (ex. Sphère Pal…)" />
            <NumberBox x:Name="QuantityBox" Grid.Column="1" Header="" Value="1" Minimum="1" Maximum="9999"
                       SpinButtonPlacementMode="Compact" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="1" Opacity="0.7" Margin="0,0,0,10" />

        <ListView x:Name="LineList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:CraftRow">
                    <Grid Padding="0,10" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{x:Bind CountBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ItemName}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind CountText}" VerticalAlignment="Center"
                                   Foreground="{x:Bind CountBrush}" FontFamily="Consolas" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Sources}" VerticalAlignment="Center"
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
